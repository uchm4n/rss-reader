{
  "manifest_version": 3,
  "version": "1.0.0",
  "name": "RSS Reader",
  "short_name": "RSS Reader",
  "description": "A local-first RSS and Atom reader.",
  "action": {
    "default_icon": {
      "16": "extension-icons/icon-gray-16.png",
      "32": "extension-icons/icon-gray-32.png",
      "48": "extension-icons/icon-gray-48.png",
      "128": "extension-icons/icon-gray-128.png"
    },
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background/index.ts"
  },
  "permissions": ["alarms", "storage", "unlimitedStorage", "notifications", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "extension-icons/icon-gray-16.png",
    "32": "extension-icons/icon-gray-32.png",
    "48": "extension-icons/icon-gray-48.png",
    "128": "extension-icons/icon-gray-128.png"
  }
}
