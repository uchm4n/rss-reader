{
  "manifest_version": 3,
  "minimum_chrome_version": "110",
  "version": "0.9.1",
  "name": "RSS Reader",
  "short_name": "RSS Reader",
  "description": "Local-first RSS, Atom, RDF and JSON feed reader. No account, no analytics; feeds and reading state stay in your browser.",
  "action": {
    "default_icon": {
      "16": "icons/icon-gray-16.png",
      "32": "icons/icon-gray-32.png",
      "48": "icons/icon-gray-48.png",
      "128": "icons/icon-gray-128.png"
    },
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background/index.ts"
  },
  "permissions": ["alarms", "storage", "unlimitedStorage", "notifications", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon-gray-16.png",
    "32": "icons/icon-gray-32.png",
    "48": "icons/icon-gray-48.png",
    "128": "icons/icon-gray-128.png"
  }
}
